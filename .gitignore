# ==========================================
# Sahayak AI - Git Ignore
# ==========================================

# 1. Environment Variables & Secrets (CRITICAL: NEVER COMMIT REAL KEYS)
.env
.env.*
*.env
!.env.example
!*.env.example

# 2. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/

# 3. Logs & Temporary Files
*.log
logs/
*.pid

# 4. IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo

# 5. Antigravity & Agent workspace artifacts
.gemini/
scratch/

# 6. Frontend & Vercel
node_modules/
.vercel/
dist/
build/
.next/

# 7. OS Specific Files
.DS_Store
Thumbs.db
desktop.ini
