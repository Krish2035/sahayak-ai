# ==========================================
# Sahayak AI - Backend Environment Configuration
# ==========================================

# 1. Google Gemini API Key
# Get your free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Server Host and Port (Render automatically provides $PORT in production)
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 3. Persistent Database (PostgreSQL / SQLite)
# Render Managed PostgreSQL format: postgresql://user:password@host:port/database
# If omitted or empty, automatically uses local persistent SQLite: sahayak.db
DATABASE_URL=

# 4. Redis Cache & Distributed Rate Limiter
# Upstash or Render Redis format: redis://default:password@host:port
# If omitted or empty, automatically uses in-memory token-bucket rate limiter
REDIS_URL=

# 5. Rate Limiting Protection (Anti-Abuse)
# Limits queries per user IP (e.g., 10/minute)
RATE_LIMIT_DEFAULT=10/minute
